rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if caller is an authenticated Firebase Admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins Collection: Protected to authenticated Admin UIDs only
    match /admins/{adminUid} {
      allow read, write: if request.auth != null && (request.auth.uid == adminUid || isAdmin());
    }

    // Subscription Plans: Publicly readable for feature checks, managed by Admins
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Promotions: Publicly readable, managed by Admins
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Restaurant Records & Subcollections
    match /restaurants/{restaurantId} {
      // Allow reading restaurant document for authentication & configuration setup
      allow read: if true;
      
      // Creating, updating, or deleting restaurant accounts restricted to Admins or valid setup
      allow create, update: if isAdmin() || request.resource.data.name != null;
      allow delete: if isAdmin();

      // Subcollections (orders, menu, inventory, tables, staff, payroll, expenses, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if restaurantId != null && restaurantId != "";
      }

      // Nested subcollections
      match /{subcollection}/{docId}/{nestedSub}/{nestedId} {
        allow read, write: if restaurantId != null && restaurantId != "";
      }
    }
  }
}